{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/CasCap.Api.SignalCli.Debug.slnx",
        "--configuration",
        "Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "detail": "Runs the credential-free unit tests, matching CI.",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "--project",
        "${workspaceFolder}/src/CasCap.Api.SignalCli.Tests/CasCap.Api.SignalCli.Tests.csproj",
        "--filter-not-trait",
        "Category=Integration"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "compose up",
      "command": "docker",
      "type": "process",
      "args": [
        "compose",
        "--file",
        "${workspaceFolder}/docker-compose.yml",
        "up",
        "--detach"
      ],
      "problemMatcher": []
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/samples/GenericHost/GenericHost.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "detail": "Runs the Generic Host sample against the configured signal-cli REST API.",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/samples/GenericHost/GenericHost.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}